# Public product config. Copy values into js/env.values.mjs
# (or js/env.local.mjs for a machine-only override).
#
# Nothing in this file is secret. Private keys and API secrets
# must never be placed in Elead-HTML.

# Display name shown on the install screen.
ELEAD_PRODUCT_LABEL=Elead

# Short description on the install screen.
ELEAD_PRODUCT_DESCRIPTION=A private line to the service provider. No phone. No email.

# Image URL shown on the install screen. Leave empty to hide the image.
ELEAD_PRODUCT_IMAGE=

# Package type native stores on install (ENS purchase).
ELEAD_PACKAGE_TYPE=ENS

# How many sessions mainscreen asks native for.
ELEAD_SESSION_RANGE=50

# How many messages a chat page asks native for.
ELEAD_MESSAGE_RANGE=40

# GET: first-message only. Lead HTML uses this when native history has no session.
# GET {url}/{fromDomain} → { inbox: "{inbox}.{domain}.global", label, domain }
# Lead product only (elead/v2.0.0). After the first message, native history is the to.
ELEAD_GET_INBOX_URL=

# GET: Semaphore group commitments + REGISTER_SCOPE.
# Fill in when the function is deployed. Required on install.html.
ELEAD_GROUP_MEMBERS_URL=

# POST: { proof, label, web3identity }. Fill in when deployed.
# Required on install.html. Do not put secrets here.
ELEAD_ACTIVATE_URL=
